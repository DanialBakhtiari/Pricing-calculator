# This folder is served as a live git clone (cPanel), under /pricing/.
# The prebuilt app lives in /dist; serve it from there, and hide VCS internals
# and source files. Requires Apache mod_rewrite (AllowOverride on).
RewriteEngine On

# Block git metadata (.git, .gitignore, .gitattributes, …).
RewriteRule (^|/)\.git - [F,L]

# Requests already mapped into /dist are served as-is (and this stops the loop).
RewriteRule ^dist/ - [L]

# Everything else is served from /dist. Source paths (src/, package.json, …)
# don't exist under /dist, so they return 404.
RewriteRule ^(.*)$ dist/$1 [L]
